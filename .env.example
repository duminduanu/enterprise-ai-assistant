# Google Gemini (LLM + embeddings)
GOOGLE_API_KEY=

# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Pinecone Vector Database (768-dim index for Gemini embeddings)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-ai-assistant-gemini
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Ingestion (Gemini free tier: ~100 embed requests/min — use small batches)
INGEST_BATCH_SIZE=5
INGEST_DELAY_SECONDS=1.5

# Hybrid retrieval
HYBRID_ALPHA=0.7
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant

# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
AUTH_REQUIRED=false

# Rate limiting (token bucket)
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# Timeouts (seconds) for async operations
LLM_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=30
MCP_TIMEOUT_SECONDS=15
AGENT_TIMEOUT_SECONDS=120

# Session memory (in-process; last N user+assistant turn pairs per session_id)
SESSION_MEMORY_MAX_TURNS=10

# Streamlit frontend
API_BASE_URL=http://127.0.0.1:8000
